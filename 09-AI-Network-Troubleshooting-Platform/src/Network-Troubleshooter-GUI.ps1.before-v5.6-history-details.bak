function Show-Page {
    param($Page)

    foreach ($p in @(
        $pageDashboard,
        $pageAnalyze,
        $pageHistory,
        $pageSystem
    )) {
        $p.Visible = $false
    }

    $Page.Visible = $true
    $Page.BringToFront()
}

