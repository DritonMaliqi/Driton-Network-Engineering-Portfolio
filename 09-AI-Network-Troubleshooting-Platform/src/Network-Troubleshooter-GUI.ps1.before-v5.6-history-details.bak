if (Test-Path $IncidentManager) {
    . $IncidentManager
}
$Reports  = Join-Path $Desktop "Network-Troubleshooter-Reports"
$History  = Join-Path $Reports "Incident-History.csv"
$Workflow = Join-Path $Desktop "Network-Troubleshooter-v4.2.ps1"

